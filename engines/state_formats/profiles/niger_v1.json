{
  "id": "state_niger",
  "jurisdiction": "niger_state",
  "label": "Niger State Approved Budget",
  "version": "1.0",
  "detection": {
    "required_phrases_any": [
      "Niger State Government",
      "NIGER STATE GOVERNMENT"
    ],
    "supporting_phrases_any": [
      "Approved Budget",
      "APPROVED",
      "2026 Approved Budget",
      "Capital Expenditure by Project"
    ],
    "admin_code_re": "\\b\\d{12}\\b",
    "location_code_re": "\\b12[0-9]{6}\\s*-\\s*[A-Z]{2,}",
    "min_location_hits_on_page": 3,
    "sample_pages": 80
  },
  "section_markers": {
    "start": [
      "Capital Expenditure by Project"
    ],
    "stop": [
      "Programme Code and Programme Description",
      "Code Administrative Unit",
      "Recurrent Expenditure by Administrative",
      "Budget Glossary",
      "Personnel Expenditure by",
      "Capital Expenditure by Administrative"
    ]
  },
  "columns": [
    {"id": "project_name", "header_fragments": ["Project Name"]},
    {"id": "administrative", "header_fragments": ["Administrative Code and Description", "Administrative Code"]},
    {"id": "economic", "header_fragments": ["Economic Code and Description", "Economic Code"]},
    {"id": "function", "header_fragments": ["Function Code and Description", "Function Code"]},
    {"id": "location", "header_fragments": ["Location Code and Description", "Location Code"]},
    {"id": "actuals_2024", "header_fragments": ["2024 Full Year Actuals"]},
    {"id": "budget_2025", "header_fragments": ["2025 Revised Budget"]},
    {"id": "performance_2025", "header_fragments": ["2025 Performance", "Performance January"]},
    {"id": "approved_2026", "header_fragments": ["2026 Approved Budget"]}
  ],
  "amount_column": "approved_2026",
  "patterns": {
    "admin_code": "(\\d{12})\\s*-\\s*",
    "location_code": "(1\\d{7})\\s*-\\s*([A-Z][A-Z\\s/&.-]{2,})",
    "economic_code": "(2[123]\\d{6})\\s*-"
  },
  "row_rules": {
    "skip_line_prefixes": ["Total Capital", "Total ", "Project Name", "Niger State Government"],
    "fragment_reject_words": [
      "OFFICE BUILDINGS",
      "RESIDENTIAL BUILDING",
      "ORGANS",
      "HOUSING",
      "EQUIPMENT",
      "AND FITTINGS",
      "BUILDINGS",
      "SET",
      "FISHING AND HUNTING",
      "AGRICULTURAL FACILITIES"
    ]
  }
}
